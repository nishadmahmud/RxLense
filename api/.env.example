# Google AI Studio API key (Gemma 4)
GEMINI_API_KEY=

# Current Gemma 4 model ids from Google AI Studio / Gemini API
# Vision: denser 31B for Rx photo extract. Text: 26B MoE for faster brief/chat.
GEMMA_VISION_MODEL=gemma-4-31b-it
GEMMA_TEXT_MODEL=gemma-4-26b-a4b-it

PORT=4000
MOCK_AI=true

# Public demo (optional): shared header X-Demo-Token — not a user login wall
DEMO_TOKEN=
RATE_LIMIT_PER_MINUTE=30
MAX_IMAGE_BYTES=8388608
